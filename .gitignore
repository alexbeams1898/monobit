# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.suo
*.user
*.sln.docstates

# Build outputs
build/
build-*/
cmake-build-*/
dist/
out/
bin/
# package.sh's transient staging dirs (NAME from
# scripts/package.sh). Zip lands at repo root; staging dir is
# normally cleaned up but the first-run failed mid-way left
# selva-oscura-vunknown/ behind, so block staging dirs by pattern.
selva-oscura-v*/
prison-escape-game-v*/
*.o
*.exe
*.dll
*.so
*.dylib
*.ozz

# Downloaded build tools (FBX2glTF, Tracy profiler, etc).
# Fetched per-checkout; not committed. Anchored to repo root so it
# does NOT match games/<scope>/tools/, which holds first-party
# build-time helpers (e.g. selva-oscura/tools/dump_world.cpp).
/tools/

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Packaged builds
*.zip

# Logs & temp
*.log
*.tmp
*.cache
tmp/
temp/

# Node (if you end up using JS/TS tools)
node_modules/
npm-debug.log*

# Python (if used for tooling)
__pycache__/
*.pyc
*.pyo
.env
venv/

# Game engine artifacts (covers most engines just in case)
*.meta
Library/
Temp/
Logs/
UserSettings/

# Assets you don't want tracked
*.psd
*.ai

# LPC raw sources (fetched by scripts/fetch_lpc.py, reassembled on demand)
games/prison-escape-game/assets/sprites/lpc/raw/

# Tracy traces
traces/

# AI debug dumps
debug/
# ...except in-source debug code (engine + game runtime debug toggles).
!games/selva-oscura/src/debug/
!games/selva-oscura/include/debug/
!engines/engine/src/debug/
!engines/engine/include/debug/

# Claude
.claude/
PLAN.md
*.vox

# Blender autosave backups
*.blend1
*.blend2

# One-shot asset generator scripts. These bootstrap a .blend file from
# spec then are abandoned; the .blend itself is the source of truth and
# gets refined by hand in Blender. Build-pipeline tools (rebookend_clip,
# stage_baked_ozz, gen_terrain_heightmap, etc.) are still tracked — they
# run on every build. Generators named `gen_*.py` / `gen_*.sh` under
# `games/*/scripts/blender/` are excluded by default.
games/*/scripts/blender/gen_*.py
games/*/scripts/blender/gen_*.sh

# Carve-outs: parametric generators that are NOT one-shot. The chapel
# generator is tuneable (stair_rise, body_width, JOINT dictionary etc.
# regenerate the geometry whenever a constant changes) AND the chapel
# exporter is the canonical build step that produces the runtime
# chapel_*.glb files. Both are real build-pipeline code, not throwaway
# bootstrappers. Add a carve-out here for any future parametric chapel-
# style script; one-shot generators stay ignored.
!games/selva-oscura/scripts/blender/gen_crypt_foundation.py
!games/selva-oscura/scripts/blender/gen_crypt_export.py
!games/selva-oscura/scripts/blender/gen_crypt_export.sh

# Files derived at build time from C++ runtime state (e.g. the
# StructureFootprint registry dumped by selva-oscura-dump-world).
# Recipient build steps consume them; source-of-truth lives in C++.
*.generated.json

# Local brainstorming / scratch files — iteration surface, not canon.
*-scratch.md

# Generated tileset inspection aids (rebuild with tools/tileset/repack.py
# --contact / --labels): a contact sheet is a big derived HTML, and an
# unfilled labels sidecar is noise until someone actually names sprites.
*_contact.html
