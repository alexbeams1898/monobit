Checks: >
  bugprone-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-default-member-init,
  modernize-use-using,
  modernize-use-emplace,
  modernize-loop-convert,
  modernize-deprecated-headers,
  performance-avoid-endl,
  performance-for-range-copy,
  performance-move-const-arg,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  performance-faster-string-find,
  performance-inefficient-string-concatenation,
  performance-inefficient-vector-operation,
  performance-type-promotion-in-math-fn,
  performance-noexcept-move-constructor,
  misc-redundant-expression,
  misc-unused-parameters,
  misc-const-correctness,
  readability-const-return-type,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-redundant-member-init,
  readability-identifier-naming,
  readability-function-cognitive-complexity,
  readability-function-size,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-slicing,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-unix.Malloc,
  -clang-analyzer-valist.Uninitialized,
  -clang-analyzer-cplusplus.NewDelete,
  -clang-analyzer-optin.performance.Padding
# Disables explained:
# - bugprone-easily-swappable-parameters: false positive on common
#   patterns (x/y/z, w/h, etc.).
# - bugprone-exception-escape: our code doesn't throw; analyzer
#   complains about std lib calls in destructors.
# - clang-analyzer-optin.core.EnumCastOutOfRange: false positive on
#   Catch2 macros.
# - clang-analyzer-unix.Malloc: analyzer can't model cgltf's malloc/free
#   pattern.
# - clang-analyzer-valist.Uninitialized: analyzer can't model va_start.
#   We have ONE va_list site (engines/engine/src/physics/PhysicsWorld.cpp
#   TraceImpl) — Jolt's JPH::Trace callback typedef is fixed C-style
#   variadic, so there's no C++-typed way to receive its args. Every
#   other logger in the codebase uses engine::log::Channel + fmt and
#   never touches va_list. Refactor was attempted and is complete
#   everywhere refactor was possible; this is the irreducible
#   external-API boundary.
# - clang-analyzer-cplusplus.NewDelete: triggers on Jolt's Reference.h
#   atomic ref-count pattern (refs use intrusive ptr semantics; analyzer
#   doesn't model the ownership transfer). Third-party header; false
#   positive at our usage sites.
# - clang-analyzer-optin.performance.Padding: encourages field reordering
#   for tight packing. Our authoring layout matches save schema +
#   doc-driven grouping; reordering for packing would scatter fields and
#   make code harder to read. Padding cost is negligible at our sizes.

# Treat warnings as errors locally and in CI — keeps the bar high
WarningsAsErrors: '*'

# Only lint our own headers, not SDL2/entt/etc in _deps
HeaderFilterRegex: '(engine|game)/.*\.(h|hpp)$'

CheckOptions:
  - key:   modernize-loop-convert.MinConfidence
    value: reasonable
  # Enforce snake_case for struct/class member variables.
  # Covers both plain members (MemberCase) and the public-struct fields
  # used throughout this codebase (PublicMemberCase).
  - key:   readability-identifier-naming.MemberCase
    value: lower_case
  - key:   readability-identifier-naming.PublicMemberCase
    value: lower_case
  # Flag functions whose nesting depth / branching makes them hard to reason about.
  # Triple-nested loops score ~9+ points; a threshold of 30 catches gratuitous nesting
  # while leaving legitimately complex systems (BFS rebuild, collision) alone.
  - key:   readability-function-cognitive-complexity.Threshold
    value: '30'
  # Catch functions that grow beyond ~250 lines before they become god-functions.
  # Existing systems (FlowField 207 LOC, Movement 243 LOC) are at the boundary;
  # CombatSystem (482 LOC) is NOLINT'd pending its own refactor ticket.
  - key:   readability-function-size.LineThreshold
    value: '250'
  - key:   readability-function-size.StatementThreshold
    value: '210'
  - key:   readability-function-size.NestingThreshold
    value: '5'
