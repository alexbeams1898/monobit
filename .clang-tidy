Checks: >
  bugprone-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-default-member-init,
  modernize-loop-convert,
  performance-avoid-endl,
  performance-for-range-copy,
  performance-move-const-arg,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,
  readability-const-return-type,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-redundant-member-init,
  readability-identifier-naming,
  readability-function-cognitive-complexity,
  readability-function-size,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -clang-analyzer-optin.core.EnumCastOutOfRange

# Treat warnings as errors locally and in CI — keeps the bar high
WarningsAsErrors: '*'

# Only lint our own headers, not SDL2/entt/etc in _deps
HeaderFilterRegex: '(engine|game)/.*\.(h|hpp)$'

CheckOptions:
  - key:   modernize-loop-convert.MinConfidence
    value: reasonable
  # Enforce snake_case for struct/class member variables.
  # Covers both plain members (MemberCase) and the public-struct fields
  # used throughout this codebase (PublicMemberCase).
  - key:   readability-identifier-naming.MemberCase
    value: lower_case
  - key:   readability-identifier-naming.PublicMemberCase
    value: lower_case
  # Flag functions whose nesting depth / branching makes them hard to reason about.
  # Triple-nested loops score ~9+ points; a threshold of 30 catches gratuitous nesting
  # while leaving legitimately complex systems (BFS rebuild, collision) alone.
  - key:   readability-function-cognitive-complexity.Threshold
    value: '30'
  # Catch functions that grow beyond ~250 lines before they become god-functions.
  # Existing systems (FlowField 207 LOC, Movement 243 LOC) are at the boundary;
  # CombatSystem (482 LOC) is NOLINT'd pending its own refactor ticket.
  - key:   readability-function-size.LineThreshold
    value: '250'
  - key:   readability-function-size.StatementThreshold
    value: '210'
  - key:   readability-function-size.NestingThreshold
    value: '5'
