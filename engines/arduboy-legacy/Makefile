## mono — 1-bit engine + games
##
## Default target builds games/rpg for the Arduboy platform in release mode.
##
## Two build variants:
##   - release (default): -Os, no debug info. This is what ships to hardware.
##   - debug:             -Og + -g3, plus DWARF info preserved through link.
##                        Used with Ardens' profiler/debugger.
##   make                  -> release build only
##   make debug            -> debug build only (compile-only — does not run;
##                            debug ELF overflows into bootloader space)
##   make ardens           -> release build + launch Ardens emulator
##   make ardens-fresh     -> wipe save + ardens
##   make ardens-watch     -> rebuild + relaunch Ardens on every source edit
##   make sdl-run          -> SDL build + launch the PC binary
##   make sdl-build-log    -> SDL build with PERF_UART_LOG (does not run)

# ---- Target hardware ----
MCU      := atmega32u4
F_CPU    := 16000000UL

# ---- Toolchain ----
CXX      := avr-g++
OBJCOPY  := avr-objcopy
SIZE     := avr-size

# avr-gcc is a native Windows binary; the MSYS bash sets TEMP=/tmp (POSIX),
# which the Windows runtime can't resolve, so it falls back to C:\WINDOWS\
# and fails with "Permission denied". Force a real Windows path.
export TEMP := C:\Users\alexb\tmp
export TMP  := C:\Users\alexb\tmp

# ---- Project layout ----
GAME      := rpg
PLATFORM  := arduboy

ENGINE_DIR    := engine
PLATFORM_DIR  := platform/$(PLATFORM)
GAME_DIR      := games/$(GAME)

# BUILD selects the variant; can be overridden on the command line.
BUILD ?= release
BUILD_DIR := build/$(GAME)-$(PLATFORM)-$(BUILD)
TARGET    := $(BUILD_DIR)/$(GAME)
ELF       := $(TARGET).elf
HEX       := $(TARGET).hex

# ---- Sources ----
SRCS := \
  $(wildcard $(PLATFORM_DIR)/*.cpp) \
  $(wildcard $(ENGINE_DIR)/*.cpp) \
  $(wildcard $(GAME_DIR)/*.cpp)

# spm_app_stub.cpp is the Ardens-only SPM helper. Default ON because
# day-to-day dev runs in Ardens; opt out with ARDENS_SPM=0 when building
# for real hardware (the stub silently NOPs on a 32u4 — SPM-from-app is
# disabled by silicon — and wastes flash bytes).
ARDENS_SPM ?= 1
ifneq ($(ARDENS_SPM),1)
  SRCS := $(filter-out $(PLATFORM_DIR)/spm_app_stub.cpp,$(SRCS))
endif

# Generated scene_entries table source: regenerated by scene_extract.py
# from the OVERLAY-linked ELF. First build pass uses a stub (all-nullptr
# table); second pass picks up real entry-point fnptrs.
GEN_SRCS := build/fxdata/scene_entries.cpp

OBJS := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(SRCS)) \
        $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(GEN_SRCS))
DEPS := $(OBJS:.o=.d)

# ---- Flags ----
# Common to both variants.
#
# -Ibuild/fxdata so generated FX offset header is on the include path.
# Game code does `#include "data_offsets.h"`; the file is generated by
# tools/fxdata/build.py and the `fxdata` target depends on the manifest.
COMMON_FLAGS := \
  -mmcu=$(MCU) \
  -DF_CPU=$(F_CPU) \
  -ffunction-sections -fdata-sections \
  -Wall -Wextra \
  -I$(ENGINE_DIR) -I$(PLATFORM_DIR) -I$(GAME_DIR) -Ibuild/fxdata \
  -MMD -MP

# Variant-specific flags.
#
# Two variants: release (ships) and debug (gdb on PC, doesn't fit the chip).
# The old "devrom" variant carried in-engine dev features (spawner, perf
# overlay) behind `#ifdef DEBUG`. Those are now on the SDL/PC side
# entirely — see platform/sdl/cli.cpp, tools/perf_logger/. The Arduboy
# build ships exactly the game and nothing else.
#
# BUILD=debug   -Og -g3. Huge, slow. For gdb stepping on PC only — will
#               NOT fit on hardware.
# BUILD=release -Os -flto + size tricks. Production. What ships.
ifeq ($(BUILD),debug)
  VARIANT_CXXFLAGS := -Og -g3
  VARIANT_LDFLAGS  := -Og -g3
else ifeq ($(BUILD),release-nolto)
  # Analysis-only variant for tools/check_stack. No -flto so .su files
  # materialize per TU. Scene-paging stays on (the OVERLAY layout is
  # what makes the binary fit at all; without it everything bloats
  # past the chip). The non-LTO build is bigger AND .data's LMA may
  # land in the bootloader region — both fine because this binary is
  # never flashed; check_stack invokes make with SKIP_LAYOUT_GATE=1
  # to suppress the layout-trap check for this variant only.
  VARIANT_CXXFLAGS := -Os -fno-jump-tables -fstack-usage -g1
  VARIANT_LDFLAGS  := -Os -fno-jump-tables -g1
  VARIANT_CXXFLAGS += -DSCENE_PAGING_ENABLED
  VARIANT_LDFLAGS  += -T platform/arduboy/scene.ld
  ifeq ($(ARDENS_SPM),1)
    VARIANT_CXXFLAGS += -DARDENS_SPM
  endif
else
  # Release: -Os because every flash byte counts. -flto lets GCC dedupe
  # identical code across translation units + inline across TU boundaries;
  # usually saves another 1-5% flash for free. The linker has to see it too.
  # -fno-jump-tables: avoid table-based switches (occasionally bigger than
  # cmp/branch chains on AVR).
  #
  # -mcall-prologues was REMOVED 2026-05-04. It saved ~1.5 KB by routing
  # every non-leaf function's prologue through a shared __prologue_saves__
  # trampoline — but that trampoline lives near .text, and scene banks
  # (added after the flag) live at __scene_bank_start = 0x4080. As scene
  # banks grew past 2 KB, bank-tail rcalls to __prologue_saves__ blew the
  # AVR R_AVR_13_PCREL ±2 KB horizon and the linker hard-errored. Every
  # debug-instrumentation attempt (DBG_TRACE, STACK_PROBE, breadcrumb
  # tracing) then busted the build. The 1.5 KB cost was bought back by
  # eliminating the recurring multi-hour debug-tooling deadlock; we still
  # have ~10 KB of flash headroom. If flash gets tight again later, the
  # right answer is more FX migrations, not bringing this back.
  VARIANT_CXXFLAGS := -Os -flto -fno-jump-tables
  VARIANT_LDFLAGS  := -Os -flto -fno-jump-tables
  # Scene paging is the canonical Arduboy release build. The OVERLAY
  # linker script places all four .scene.<NAME> sections at the same
  # VMA; only TITLE bank's bytes ship in the .hex, the others live on
  # FX as cold copies. set_active() pages them in via SPM through the
  # bootloader trampoline. Requires kp_boot_32u4 installed on the
  # target device (or ARDENS_SPM=1 for emulator testing).
  # Spec + runbook: docs/scene-paging.md.
  VARIANT_CXXFLAGS += -DSCENE_PAGING_ENABLED
  VARIANT_LDFLAGS  += -T platform/arduboy/scene.ld
  # ARDENS_SPM (default 1): Ardens-only testing path. The SPM trampoline
  # call is redirected from 0x7FF0 (real kp_boot_32u4 entry) to an
  # in-app stub at `app_spm_trampoline_entry` defined in
  # platform/arduboy/spm_app_stub.cpp. This works in Ardens because the
  # emulator doesn't enforce the SPM-from-app silicon restriction
  # (verified in Ardens src). DO NOT ship this build to real hardware
  # — the stub silently NOPs on a 32u4 and the swap produces garbage.
  # For hardware builds, run with `make ARDENS_SPM=0 all`.
  ifeq ($(ARDENS_SPM),1)
    VARIANT_CXXFLAGS += -DARDENS_SPM
  endif
endif

# DBG_TRACE: enable engine/dbg.h tracepoints at link time. Off by
# default; the dbg::trace bodies are empty inline stubs, so disabled
# builds carry zero cost. Pass DBG_TRACE=1 on the make command line to
# enable: `make all DBG_TRACE=1` or `make ardens-fresh DBG_TRACE=1`.
# See tools/dbg_trace/README.md for the workflow.
ifeq ($(DBG_TRACE),1)
  VARIANT_CXXFLAGS += -DDBG_TRACE
endif

# STACK_PROBE: paint unused stack with a sentinel at boot, expose
# stack_probe::peak_bytes() to read empirical high-water. Off by
# default; bodies are empty inline stubs when undefined. Companion to
# the static analyzer scripts/check_stack.py (which catches what's
# statically reachable; the runtime probe catches the rest).
# Reference: engine/stack_probe.h.
ifeq ($(STACK_PROBE),1)
  VARIANT_CXXFLAGS += -DSTACK_PROBE
endif

CXXFLAGS := $(COMMON_FLAGS) $(VARIANT_CXXFLAGS) \
  -std=c++17 \
  -fno-exceptions -fno-rtti -fno-threadsafe-statics

# --relax replaces 4-byte call/jmp with 2-byte rcall/rjmp where the target
# is in range. Free flash savings; never hurts.
LDFLAGS  := -mmcu=$(MCU) $(VARIANT_LDFLAGS) -Wl,--gc-sections -Wl,--relax -Wl,-Map=$(TARGET).map

# ---- Rules ----
.PHONY: all size ram-gate flash-gate clean ardens ardens-watch ardens-fresh format format-check setup-hooks debug wipe-save sprite sprite-convert audit progmem-check efficiency-lint data-report stack-report sdl sdl-run sdl-clean sdl-build-log sdl-perf-check audit-all verify-parity fxdata scene-audit

ARDENS := /c/Users/alexb/Tools/Ardens/Ardens.exe

# ---- FX data image ------------------------------------------------------
# Generated assets for the Arduboy FX 16 MB SPI flash. Built from
# tools/fxdata/manifest.txt; produces data.bin (the flat byte image)
# and data_offsets.h (constexpr offsets + sizes per asset). Both are
# regenerated when the manifest or the builder script changes.
FX_MANIFEST  := tools/fxdata/manifest.txt
FX_BUILDER   := tools/fxdata/build.py
FX_DATA_BIN  := build/fxdata/data.bin
FX_OFFSETS_H := build/fxdata/data_offsets.h

# Single rule produces both outputs; depend on $(FX_OFFSETS_H) and Make
# will only run the recipe once even if both files are needed.
$(FX_OFFSETS_H) $(FX_DATA_BIN): $(FX_MANIFEST) $(FX_BUILDER)
	@python $(FX_BUILDER)

fxdata: $(FX_OFFSETS_H) $(FX_DATA_BIN)

# Scene-paging generated artifacts. The first compile pass sees stubs
# (all-nullptr table); subsequent passes run scene_extract to fill in
# real entry-point fnptrs from the OVERLAY-linked ELF.
SCENE_ENTRIES_CPP := build/fxdata/scene_entries.cpp
SCENE_OFFSETS_H   := build/fxdata/scene_offsets.h

$(SCENE_ENTRIES_CPP) $(SCENE_OFFSETS_H):
	@python -m tools.fxdata.scene_extract --stub

## `all` runs the full three-pass scene-paging pipeline:
##   Pass 1: compile with stub scene_entries.cpp (all-nullptr) -> ELF.
##   Pass 2: extract real scene_entries.cpp from pass-1 ELF, rebuild;
##           this is the FINAL ELF with stable layout.
##   Pass 3: extract cold copies from FINAL ELF, bundle into data.bin
##           (cold bytes MUST match deployed .hex byte-for-byte —
##           mismatched .text size between passes causes lds-address
##           divergence and post-swap EEPROM-OOB), then rebuild once
##           more to refresh scene_offsets.h dependency chain.
##
## Final artifacts:
##   $(STRIPPED_ELF)           — TITLE bank only; what .hex was made from
##   $(HEX)                    — flashable image (~14 KB)
##   build/fxdata/data.bin     — manifest assets + 4 scene cold copies
##   build/fxdata/scene_offsets.h  — FX offsets/sizes per scene
##   build/fxdata/scene_entries.cpp — scene_vtables[] table
##
## Quick build (no pipeline orchestration, useful when only minor edits
## that don't change scene layouts): `make quick-build`.
all:
	@echo "[paging] pass 1: stub scene_entries -> ELF"
	@python -m tools.fxdata.scene_extract --stub
	@$(MAKE) quick-build
	@echo ""
	@echo "[paging] extract real scene_entries from pass-1 ELF"
	@python -m tools.fxdata.scene_extract
	@touch $(SCENE_ENTRIES_CPP)
	@echo ""
	@echo "[paging] pass 2: real scene_entries -> FINAL ELF"
	@$(MAKE) quick-build
	@echo ""
	@echo "[paging] extract cold copies from final ELF"
	@python -m tools.fxdata.scene_extract
	@echo ""
	@echo "[paging] bundle cold copies into data.bin"
	@python -m tools.fxdata.build --with-scenes
	@touch $(SCENE_ENTRIES_CPP)
	@echo ""
	@echo "[paging] pass 3: refresh artifacts (final consistent state)"
	@$(MAKE) quick-build
	@echo ""
	@echo "[paging] DONE. data.bin and rpg.hex are coherent."

## `quick-build`: single-pass build, used internally by `all` and
## occasionally by hand when the scene layout is known stable. Does NOT
## refresh cold copies; if you changed a SCENE_FN body, run `make all`
## or the runtime swap will load stale bytes.
.PHONY: quick-build
quick-build: fxdata $(HEX) size flash-gate ram-gate paging-layout-gate

# Object files depend on the generated headers so a manifest or
# pipeline change triggers a rebuild of any TU that includes them.
GEN_DEPS := $(FX_OFFSETS_H) $(SCENE_OFFSETS_H) $(SCENE_ENTRIES_CPP)

$(BUILD_DIR)/%.o: %.cpp $(GEN_DEPS)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(ELF): $(OBJS)
	@mkdir -p $(dir $@)
	$(CXX) $(LDFLAGS) $(OBJS) -o $@

# The final .hex contains ONLY the boot-resident TITLE bank's bytes —
# the other three scenes' .scene.<NAME> sections are stripped (they
# live on FX as cold copies, loaded at runtime by the swap manager).
STRIPPED_ELF := $(TARGET).stripped.elf
HEX_STRIP_FLAGS := --remove-section=.scene.MAIN_MENU \
                   --remove-section=.scene.GATE \
                   --remove-section=.scene.PLAY

$(STRIPPED_ELF): $(ELF)
	$(OBJCOPY) $(HEX_STRIP_FLAGS) $< $@

$(HEX): $(STRIPPED_ELF)
	$(OBJCOPY) -O ihex -R .eeprom $< $@

## Flash + RAM size summary. avr-size's `Program:` line undercounts
## once .scene.* sections exist (it only sums .text + .data + .bootloader),
## so we also print the true flash total via check_flash.py which sums
## every CODE+ALLOC+LOAD section.
##
## The gate reads the STRIPPED ELF (only TITLE bank resident); the
## un-stripped ELF would lie about real flash usage by counting all four
## banks even though three live on FX.
GATE_ELF := $(STRIPPED_ELF)

size: $(GATE_ELF)
	@$(SIZE) --mcu=$(MCU) --format=avr $(GATE_ELF)
	@python scripts/check_flash.py $(GATE_ELF) 100 | sed 's/^FLASH gate OK:/Flash (incl. .scene.*):/'

## RAM gate: stack-smash risk starts when stack headroom drops under
## ~200 B (stack grows down from RAMEND into .bss). 85% .bss+.data leaves
## 384 B formal headroom. `make stack-report` measures static peak — but
## the analyzer's .su-frame matching is fragile: small code changes can
## reveal previously-unmatched nodes and swing the peak by ~100 B (e.g.
## a 148 -> 265 jump from one .su match shifting the deepest path through
## draw_shades_detail). Treat reported peak as a lower bound, not gospel.
##
## NOTE on the 93% experiment (2026-04-30): vestigia's commit_slot_change
## had a 256 B stack-local that, under LTO, inlined into
## update_main_menu_scene's frame and blew the stack ceiling on slot
## save. We moved the 256 B to a static .bss buffer (vestigia::commit_buf)
## and bumped this ceiling 85 -> 93 to accommodate. That fixed the
## save crash but introduced a different stack-overflow: with .bss
## reaching 0x0a38, only 199 B of stack remained. main's deep
## title-render chain (game::init inlined + draw_fx_sprite's 64 B
## buf + audio ISR's 13 B push) exceeded the new headroom and the
## chip PC-OOB-crashed at boot rendering the title.
##
## Both versions (stack-local AND static-.bss) are stack-overflow
## scenarios — they just relocate which call path overflows. Reverted
## back to 85% here; the vestigia write_slot stack issue needs a
## different fix (chunked writes, sharing scratch with the framebuffer
## during the blocking write window, or breaking the inlining).
##
## See: memory entry project_vestigia_stack_overflow_2026_04_30 for
## the full investigation timeline.
RAM_CEILING_PCT ?= 85
ram-gate: $(ELF)
	@python scripts/check_ram.py $(ELF) $(RAM_CEILING_PCT)

## Flash gate: avr-gcc/avr-size report against the full 32 KB flash, but
## the bootloader reserves the top portion. Default = 4096 B (Caterina,
## stock Arduboy). Override BOOTLOADER_BYTES for community variants:
## `make BOOTLOADER_BYTES=3072` for Cathy3K (gains +1 KB headroom).
## FLASH_CEILING_PCT lets you ship over the usable area on purpose; past
## 100% bricks USB-flashing on real hardware.
FLASH_CEILING_PCT ?= 100
BOOTLOADER_BYTES  ?= 4096
export BOOTLOADER_BYTES
flash-gate: $(GATE_ELF)
	@python scripts/check_flash.py $(GATE_ELF) $(FLASH_CEILING_PCT)

## Static check: no raw <avr/pgmspace.h> outside platform/arduboy/.
## Catches the recurring sin where a new file reaches for the AVR header
## instead of the portable shim.
progmem-check:
	@python scripts/check_progmem_violations.py

## Project-specific efficiency / correctness lint. Catches AVR-flavored
## traps not covered by clang-tidy: unjustified 32-bit casts, stack-smash
## buffer pairings, missing PROGMEM on extern decls, etc. See
## tools/efficiency_lint/README.md for the rule list.
efficiency-lint:
	@PYTHONPATH=tools python -m efficiency_lint

## Top-20 symbols by size landing in .data / .bss / .rodata. Useful when
## hunting what blew the budget after a feature lands. Read-only — never
## fails the build; for eyes, not gates.
data-report: $(ELF)
	@echo "#### Top-20 .data / .bss / .rodata symbols ####"
	@avr-nm --size-sort -r -S $(ELF) 2>/dev/null | awk '$$3 ~ /^[DdBbRr]$$/' | head -20

## Stack-headroom analysis. Builds a parallel no-LTO variant with
## -fstack-usage, parses the .su files + call graph, computes worst-case
## stack peak from main, and fails if it could collide with .bss. The
## -fstack-usage flag doesn't compose with -flto (LTO defers codegen
## past the per-TU emission), so this is an UPPER-BOUND estimate — the
## real ship build's LTO inlining usually shrinks stack peaks further.
##
## Why this exists: stack-vs-.bss collision is the silent killer that
## bit cand-1's logo decoder. Static lint catches single big buffers
## (large-stack-buffer rule), but only this tool catches "OK on its own
## but the whole call chain blows the stack."
stack-report:
	@python scripts/check_stack.py

## Scene-paging viability audit. Walks avr-nm + objdump on the release
## ELF, classifies every function into CORE / PLAYING / MENUS / CUTSCENES
## / UNKNOWN, and reports per-scene size + cross-scene call edges.
##
## --strict mode fails if any function is UNKNOWN (audit rules drift from
## reality) or if any pageable scene calls another (boundary breach).
## Wired into audit-all so SCENE_RULES drift is caught at commit time.
##
## Background: tools/scene_audit/README and the rule list inside
## tools/scene_audit/__main__.py.
scene-audit: $(ELF)
	@python -m tools.scene_audit --strict

## Static linker-layout gate. Verifies the SPM-paging build doesn't
## have .data's flash source image inside the bank's rewritable region
## (Bug 2 from docs/known-bugs/scene-paging-boot-recovery.md), and
## that neither bank-end nor .data-end crosses into the bootloader.
## Catches structural linker-script regressions in CI before they
## reach hardware.
paging-layout-gate: $(ELF)
	@python3 scripts/check_paging_layout.py $(ELF)

## Headless Ardens smoke harness. Boots the linked .hex against
## data.bin in absim's emulated CPU and trips on any of the eight
## autobreak signals (OOB-PC, OOB-DEREF, NULL-DEREF, OOB-EEPROM,
## STACK-OVERFLOW, OOB-IJMP, NULL-REL-DEREF, UNKNOWN-INSTR) firing
## during a 5-second simulated cold boot. Catches CPU-level
## misbehaviors that no static check can see — buffer overruns,
## miscompiled inline asm, ISR/main-thread register collisions,
## wild pointer derefs.
##
## Pulls absim from the pinned `tools/ardens` submodule. First-time
## setup: `git submodule update --init --recursive tools/ardens`.
##
## Build is incremental via CMake/Ninja; subsequent runs are fast.
ARDENS_SMOKE_BUILD := tools/ardens_smoke/build
ARDENS_SMOKE_EXE   := $(ARDENS_SMOKE_BUILD)/ardens_smoke.exe

$(ARDENS_SMOKE_EXE): tools/ardens_smoke/main.cpp tools/ardens_smoke/CMakeLists.txt
	@cmake -B $(ARDENS_SMOKE_BUILD) -S tools/ardens_smoke -G Ninja \
	  -DCMAKE_BUILD_TYPE=Release \
	  -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++ >/dev/null
	@cmake --build $(ARDENS_SMOKE_BUILD) --config Release

ardens-smoke: $(ELF) $(ARDENS_SMOKE_EXE) $(FX_DATA_BIN)
	@$(ARDENS_SMOKE_EXE) $(HEX) $(FX_DATA_BIN) --scenario=cold
	@$(ARDENS_SMOKE_EXE) $(HEX) $(FX_DATA_BIN) --scenario=swap-reset \
	  --seconds=10 \
	  --bank-addr=0x$$(avr-nm $(ELF) | awk '/__scene_bank_start/ {print $$1; exit}')

## Alias for explicitness — runs only the swap-reset scenario. Same
## guarantees; useful when you want to skip the slower cold scenario.
ardens-smoke-swap-reset: $(ELF) $(ARDENS_SMOKE_EXE) $(FX_DATA_BIN)
	@$(ARDENS_SMOKE_EXE) $(HEX) $(FX_DATA_BIN) --scenario=swap-reset \
	  --seconds=10 \
	  --bank-addr=0x$$(avr-nm $(ELF) | awk '/__scene_bank_start/ {print $$1; exit}')

## Run every discipline check in one target. Fails fast on progmem-check
## or efficiency-lint violations; ram-gate is covered by `make`;
## data-report is informational.
audit: progmem-check efficiency-lint data-report paging-layout-gate
	@echo "#### audit complete ####"

## Ardens save state lives in %APPDATA%/Ardens/absim_<hash>.save — one per
## unique compiled binary. We tried a project-local `save=<path>` but Ardens
## treats `save=` as load-only and immediately clobbers it with the AppData
## cache on launch (and autosaves only back to AppData), so it's useless for
## persistence. Source of truth is the AppData file; wipe-save nukes it.
ARDENS_APPDATA := /c/Users/alexb/AppData/Roaming/Ardens

## Build (if needed) and launch Ardens with the freshly built hex AND
## the FX data image. Ardens uses `key=value` CLI syntax and accepts
## multiple file= args; the second `file=` is interpreted as the FX
## flash image.
ardens: all
	@"$(ARDENS)" "file=$(shell cygpath -m $(abspath $(HEX)))" "file=$(shell cygpath -m $(abspath $(FX_DATA_BIN)))" &

## Debug build (-Og -g3, no LTO). Pure compile target — never run in
## Ardens. The debug ELF spills into the bootloader-reserved range
## (top 4 KB of flash) and corrupts interrupt vectors / chip state when
## loaded, which surfaces as spurious EEPROM-OOB traps and a black
## screen. For function-name profiling in Ardens, use the release build
## and map addresses against `avr-objdump -d build/.../rpg.elf`.
debug:
	@$(MAKE) BUILD=debug all

## Wipe all Ardens AppData save files + relaunch. Use when you want a fresh
## character or Ardens is misbehaving. (Each build hash has its own save, so
## we nuke them all rather than trying to compute the current hash.)
ardens-fresh: wipe-save
	@$(MAKE) ardens

## Wipe every Ardens AppData save (all build hashes). Since the save hash is
## derived from the compiled binary, every rebuild produces a new save file
## anyway — so wiping them all is the correct "start fresh" gesture.
wipe-save:
	@rm -f "$(ARDENS_APPDATA)/"absim_*.save
	@echo "Cleared all Ardens save state in $(ARDENS_APPDATA)."

## Rebuild + relaunch Ardens on every source change. Polls every 1s — no
## extra tooling required. Re-launches Ardens after each successful build
## so the new hex is loaded; close the previous Ardens window manually if
## stacking gets annoying.
ardens-watch:
	@./scripts/watch.sh

clean:
	rm -rf build

## Format every C/C++ source file in place.
format:
	@find engine platform games -type f \( -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.c' \) -print0 | xargs -0 clang-format -i

## Check formatting without modifying files. Exits non-zero if anything would change.
format-check:
	@find engine platform games -type f \( -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.c' \) -print0 | xargs -0 clang-format --dry-run --Werror

## ---- Sprites ------------------------------------------------------------
## Open Aseprite on a fresh blank canvas at the requested dimensions.
##   make sprite NAME=foo W=8 H=12
## Pre-creates art/foo.png so Aseprite has something to open (its CLI
## can't make new files). Save with Ctrl+S to overwrite in place.
sprite:
ifndef NAME
	$(error NAME=<spritename> required (e.g. make sprite NAME=player W=8 H=12))
endif
ifndef W
	$(error W=<width> required)
endif
ifndef H
	$(error H=<height> required)
endif
	@python scripts/new_sprite.py $(NAME) $(W) $(H)

## Convert a saved PNG into the engine's PROGMEM byte format.
##   make sprite-convert NAME=foo
## Reads art/foo.png, prints a paste-ready const u8 array to stdout.
sprite-convert:
ifndef NAME
	$(error NAME=<spritename> required (e.g. make sprite-convert NAME=player))
endif
	@python scripts/png_to_sprite.py art/$(NAME).png --name $(shell echo $(NAME) | tr a-z A-Z)

## Install the pre-commit hook into .git/hooks.
setup-hooks:
	@mkdir -p .git/hooks
	@printf '#!/usr/bin/env bash\nexec ./scripts/pre-commit.sh\n' > .git/hooks/pre-commit
	@chmod +x .git/hooks/pre-commit
	@echo "Installed .git/hooks/pre-commit -> scripts/pre-commit.sh"

## ---- SDL (PC) target ----------------------------------------------------
## Wraps the CMake build in CMakeLists.txt so all platforms share the same
## entry point (make ...). Does NOT interact with the Arduboy build — uses
## its own build-sdl/ directory. Requires MSYS2 MinGW64 + CMake + Ninja.
##
##   make sdl              -> configure (if needed) + build
##   make sdl-run          -> sdl + launch the resulting exe
##   make sdl-build-log    -> rebuild with PERF_UART_LOG=ON. Does NOT launch —
##                            print the command to invoke for binary frame log.
##   make sdl-clean        -> wipe build-sdl/ only (Arduboy build untouched)
## SDL builds in two flavors with separate dirs:
##   build-sdl/      — clean (no PERF_UART_LOG). Used by `sdl`, `sdl-run`,
##                     and the audio capture flag. stdout stays clean so
##                     the user can see SDL_Log messages.
##   build-sdl-perf/ — instrumented (PERF_UART_LOG=ON). Used by
##                     `sdl-build-log` and `sdl-perf-check`. stdout becomes
##                     a binary trace stream — never run interactively.
##
## Earlier we used a single dir and reconfigured between flavors; that
## meant every audit-all run left the SDL exe in PERF_UART_LOG mode and
## the user's next manual launch dumped trace bytes to their terminal.
SDL_BUILD_DIR      := build-sdl
SDL_EXE            := $(SDL_BUILD_DIR)/bin/mono-sdl.exe
SDL_PERF_BUILD_DIR := build-sdl-perf
SDL_PERF_EXE       := $(SDL_PERF_BUILD_DIR)/bin/mono-sdl.exe

$(SDL_BUILD_DIR)/build.ninja: CMakeLists.txt
	@cmake -S . -B $(SDL_BUILD_DIR) -G Ninja -DCMAKE_BUILD_TYPE=Release

## $(SDL_EXE) is a real file but ninja owns its real dependency graph
## (every .cpp / .h via the per-object .d files cmake generates). Make
## doesn't know about those — its only declared dep is build.ninja,
## which doesn't change when sources do. Result: Make would see the
## exe as up-to-date and skip rebuild even when sources changed,
## producing a stale SDL binary while the Arduboy build had the
## current code (silent platform-parity drift, exactly what the parity
## gate exists to catch — but the gate was being fooled too).
##
## Fix: declare the rule .PHONY-equivalent by always running it.
## `cmake --build` is fast when nothing changed (~50 ms) so the cost
## is negligible. Delegating dependency tracking to ninja is the
## correct division of labor here; ninja knows the source graph.
.PHONY: $(SDL_EXE)
$(SDL_EXE): $(SDL_BUILD_DIR)/build.ninja
	@cmake --build $(SDL_BUILD_DIR)

# data.bin lives next to the SDL exe so the file-backed FX backend can
# fopen("data.bin") directly. Copying instead of symlinking because
# Windows treats symlinks as a privilege.
$(SDL_BUILD_DIR)/bin/data.bin: $(FX_DATA_BIN) $(SDL_EXE)
	@cp $(FX_DATA_BIN) $@

sdl: $(SDL_EXE) $(SDL_BUILD_DIR)/bin/data.bin

sdl-run: sdl
	@$(SDL_EXE)

$(SDL_PERF_BUILD_DIR)/build.ninja: CMakeLists.txt
	@cmake -S . -B $(SDL_PERF_BUILD_DIR) -G Ninja -DCMAKE_BUILD_TYPE=Release -DPERF_UART_LOG=ON

## Same delegate-to-ninja pattern as $(SDL_EXE) above.
.PHONY: $(SDL_PERF_EXE)
$(SDL_PERF_EXE): $(SDL_PERF_BUILD_DIR)/build.ninja
	@cmake --build $(SDL_PERF_BUILD_DIR)

$(SDL_PERF_BUILD_DIR)/bin/data.bin: $(FX_DATA_BIN) $(SDL_PERF_EXE)
	@cp $(FX_DATA_BIN) $@

sdl-build-log: $(SDL_PERF_EXE) $(SDL_PERF_BUILD_DIR)/bin/data.bin
	@echo "Run with: $(SDL_PERF_EXE) > trace.bin"

## Run the SDL build for ~10s, capture a perf trace, assert every frame
## stayed under the 266,667-cycle Arduboy budget. The SDL build's perf
## hooks charge per-op AVR-cycle estimates — a frame over budget would
## drop on real Arduboy. Wired into audit-all so feature work that blows
## the per-frame budget cannot silently land.
sdl-perf-check: sdl-build-log
	@python scripts/check_perf.py

sdl-clean:
	rm -rf $(SDL_BUILD_DIR) $(SDL_PERF_BUILD_DIR)

## ---- Cross-platform audit ----------------------------------------------
## Single command: verify the Arduboy build passes flash+RAM gates, the
## SDL build still compiles, the efficiency linter is clean, and the
## SDL perf check shows every frame under the Arduboy 266,667-cycle
## budget. Use this before committing anything that touches engine/ or
## games/. The perf-check is the gate that catches "looks fine on PC,
## drops frames on Arduboy" regressions — without it, work like the
## TITLE-budget overrun ships silently because PC always hits 60 FPS.
audit-all: all efficiency-lint scene-audit sdl-perf-check
	@echo ""
	@echo "================ audit-all ================"
	@echo "Arduboy: $$($(SIZE) --mcu=$(MCU) --format=avr $(ELF) | awk '/Program:/ {print $$2}') B / 28672 B"
	@echo "SDL:     $$(stat -c %s $(SDL_EXE) 2>/dev/null || wc -c < $(SDL_EXE)) B"
	@echo "All targets green."

## Parity gate: ensure BOTH platforms build cleanly. Cheap mechanical
## check, suitable for pre-commit. Doesn't prove behavior matches —
## that requires running both in `make ardens` and `make sdl-run` and
## eyeballing the same beat per docs/platform-parity.md — but does
## catch the silent-rot case where a change compiles for Arduboy but
## not SDL (or vice versa). Runs in <30s on a warm tree.
##
## Used by .git/hooks/pre-commit (see scripts/pre-commit.sh) when any
## staged change touches shared code (engine/, games/, or platform/).
verify-parity: all sdl
	@echo ""
	@echo "============== verify-parity =============="
	@echo "Arduboy: $$($(SIZE) --mcu=$(MCU) --format=avr $(ELF) | awk '/Program:/ {print $$2}') B / 28672 B"
	@echo "SDL:     $$(stat -c %s $(SDL_EXE) 2>/dev/null || wc -c < $(SDL_EXE)) B"
	@echo "Both targets compile. Behavior parity must still be eyeballed"
	@echo "in 'make ardens' and 'make sdl-run' per docs/platform-parity.md."

-include $(DEPS)
