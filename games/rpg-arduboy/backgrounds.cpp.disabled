// Per-tile start offsets into STREAM[].
const u16 OFFSETS[3] PROGMEM = {
    0,
    1024,
    2048,
};

}  // namespace

// Blit one full-resolution card straight from PROGMEM into
// `out` (1024 bytes, page-major). `card` is 0..CARD_COUNT-1, NOT
// a circle index — call it via CIRCLE_TO_CARD[] in game.cpp.
// Used only by the CIRCLE_CARD transition state; never called
// during active gameplay.
void render(u8 card, u8* out) {
  if (card >= 3) {
    for (u16 i = 0; i < 1024; ++i)
      out[i] = 0;
    return;
  }
  const u16 src = pgm_read_word(&OFFSETS[card]);
  for (u16 i = 0; i < 1024; ++i) {
    out[i] = pgm_read_byte(&STREAM[src + i]);
  }
}

}  // namespace backgrounds
