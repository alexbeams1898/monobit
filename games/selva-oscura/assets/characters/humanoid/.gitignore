# `source/` holds raw FBX authoring assets — Mixamo packs and the
# humanoid character itself. The build reads from here; we don't commit
# the heavyweight .fbx files (anyone can re-download from Mixamo).
source/

# mblab_generated/ holds Blender .blend files + intermediate FBX exports
# from the MB-Lab + Auto-Rig Pro authoring workflow (~96MB). Author-side
# only -- not consumed by the build, not needed by CI.
mblab_generated/

# humanoid.glb and .ozz files ARE committed (~2.7 MB total) so CI and
# contributors without the gitignored Mixamo FBX pack can build and run.
# Locally, the CMake bake regenerates them from FBX when present.
# Negate the repo-root *.ozz rule for everything in this directory.
!*.ozz
!humanoid.glb
